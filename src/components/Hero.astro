---
---

<section class="hero" id="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-content">
      <h1>Pouzdan električar u Zagrebu i okolici</h1>
      <p class="hero-sub">
        Od hitnih intervencija do kompletnih elektroinstalacija.
        Vaša sigurnost, naš je prioritet.
      </p>
      <a class="btn btn--gold hero-cta" href="#kontakt">Zatraži besplatnu procjenu</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    color: var(--et-white);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        rgba(16, 25, 33, 0.92) 0%,
        rgba(16, 25, 33, 0.78) 45%,
        rgba(16, 25, 33, 0.45) 100%
      ),
      url('/images/hero-strujni-ormar.jpg');
    background-size: cover;
    background-position: center;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(4rem, 11vw, 8.5rem);
  }
  .hero-content { max-width: 640px; }
  .hero h1 {
    color: var(--et-white);
    margin-bottom: 1rem;
  }
  .hero-sub {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2rem;
    max-width: 540px;
  }
  .hero-cta {
    font-size: 1.1rem;
    padding: 1.05rem 2rem;
    box-shadow: 0 8px 24px rgba(255, 185, 42, 0.35);
  }
</style>
