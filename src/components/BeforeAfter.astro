---
interface Props {
  heading: string;
  text?: string;
  beforeImg: string;
  afterImg: string;
}
const { heading, text, beforeImg, afterImg } = Astro.props;
---

<section class="section before-after">
  <div class="container">
    <header class="ba-head">
      <span class="eyebrow">Iz prakse</span>
      <h2>{heading}</h2>
      {text && <p class="ba-text">{text}</p>}
    </header>
    <div class="ba-grid">
      <figure class="ba-item">
        <span class="ba-tag ba-tag--before">Prije</span>
        <img src={beforeImg} alt="Stari strujni ormarić prije zamjene" loading="lazy" />
      </figure>
      <figure class="ba-item">
        <span class="ba-tag ba-tag--after">Poslije</span>
        <img src={afterImg} alt="Novi strujni ormar nakon zamjene" loading="lazy" />
      </figure>
    </div>
  </div>
</section>

<style>
  .ba-head { text-align: center; max-width: 720px; margin: 0 auto 3rem; }
  .ba-text { color: var(--et-gray); font-size: 1.1rem; margin-top: 0.5rem; }
  .ba-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    max-width: 880px;
    margin-inline: auto;
  }
  .ba-item {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 12px 28px rgba(16, 25, 33, 0.14);
    aspect-ratio: 3 / 4;
  }
  .ba-item img { width: 100%; height: 100%; object-fit: cover; }
  .ba-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 1;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ba-tag--before { background: var(--et-ink); color: var(--et-white); }
  .ba-tag--after { background: var(--et-gold); color: var(--et-ink); }

  @media (max-width: 640px) {
    .ba-grid { grid-template-columns: 1fr; max-width: 360px; }
  }
</style>
