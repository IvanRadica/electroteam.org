---
interface Item {
  name: string;
  desc: string;
}
interface Column {
  title: string;
  items: Item[];
}
interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  columns: Column[];
}
const { eyebrow, heading, intro, columns } = Astro.props;
---

<section class="section checklist">
  <div class="container">
    <header class="cl-head">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{heading}</h2>
      {intro && <p class="cl-intro">{intro}</p>}
    </header>

    <div class="cl-grid">
      {columns.map((col) => (
        <div class="cl-col">
          <h3>{col.title}</h3>
          <ul>
            {col.items.map((it) => (
              <li>
                <span class="cl-check" aria-hidden="true">✓</span>
                <span><strong>{it.name}:</strong> {it.desc}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cl-head { text-align: center; max-width: 760px; margin: 0 auto 3rem; }
  .cl-intro { color: var(--et-gray); font-size: 1.1rem; margin-top: 0.5rem; }

  .cl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }
  .cl-col {
    background: var(--et-offwhite);
    border: 1px solid var(--et-border);
    border-radius: var(--radius);
    padding: 1.75rem;
  }
  .cl-col h3 {
    margin-bottom: 1.1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--et-gold);
  }
  .cl-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .cl-col li { display: flex; gap: 0.6rem; align-items: flex-start; color: var(--et-gray); }
  .cl-col li strong { color: var(--et-ink); }
  .cl-check {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--et-gold);
    color: var(--et-ink);
    font-size: 0.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .cl-grid { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
  }
</style>
