---
const year = new Date().getFullYear();
const socials = [
  { label: 'Facebook', href: '#' },
  { label: 'Instagram', href: '#' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="footer-brand" href="#hero" aria-label="Electro Team">
      <img src="/logo/et-logo-white.png" alt="Electro Team" />
    </a>

    <p class="copyright">Copyright © {year} Electro Team. Sva prava pridržana.</p>

    <ul class="socials">
      {socials.map((s) => (
        <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--et-ink);
    color: rgba(255, 255, 255, 0.8);
    border-top: 3px solid var(--et-gold);
    padding-block: 2.25rem;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-brand img { height: 34px; width: auto; }
  .copyright { margin: 0; font-size: 0.92rem; }
  .socials {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .socials a {
    font-weight: 600;
    color: var(--et-gold);
  }
  .socials a:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .footer-inner { flex-direction: column; text-align: center; }
  }
</style>
