---
const reasons = [
  {
    title: 'Certificirani majstori',
    text: 'Naš tim čine iskusni profesionalci koji su prošli sve potrebne certifikacije. Svaki posao shvaćamo ozbiljno, bez obzira na opseg projekta.',
    icon: 'certifikat',
  },
  {
    title: 'Rad po standardima',
    text: 'Sigurnost nema cijenu. Sve radove izvodimo prema važećim propisima i standardima.',
    icon: 'stit',
  },
  {
    title: 'Prostor ostavljamo urednim',
    text: 'Znamo da radovi mogu biti stresni. Poštujemo dogovorene rokove i nakon završetka posla vaš prostor ostavljamo čistim.',
    icon: 'urednost',
  },
];
---

<section class="section why" id="zasto">
  <div class="container">
    <header class="section-head">
      <span class="eyebrow eyebrow--light">Zašto baš mi</span>
      <h2>Zašto odabrati Electro Team?</h2>
    </header>

    <div class="why-grid">
      {reasons.map((r) => (
        <div class="why-card">
          <span class="why-icon">
            {r.icon === 'certifikat' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="8" r="5" />
                <path d="M8.5 12.5 7 21l5-2.5L17 21l-1.5-8.5" />
              </svg>
            )}
            {r.icon === 'stit' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2 4 5v6c0 5 3.5 8.5 8 11 4.5-2.5 8-6 8-11V5l-8-3Z" />
                <path d="M13 8l-3 4.5h3L10 17" />
              </svg>
            )}
            {r.icon === 'urednost' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 20c2-3 5-4 8-4s6 1 8 4" />
                <path d="M14 4l6 6" />
                <path d="M17 7 9 15l-2 2-3 1 1-3 2-2 8-8Z" />
              </svg>
            )}
          </span>
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why {
    background: var(--et-ink);
    color: var(--et-white);
  }
  .why .section-head h2 { color: var(--et-white); }
  .eyebrow--light { color: var(--et-gold); }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .why-card {
    text-align: center;
    padding: 1rem;
  }
  .why-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    margin-bottom: 1.25rem;
    border-radius: 50%;
    background: rgba(255, 185, 42, 0.14);
    color: var(--et-gold);
  }
  .why-icon svg { width: 36px; height: 36px; }
  .why-card h3 { color: var(--et-white); margin-bottom: 0.5rem; }
  .why-card p { color: rgba(255, 255, 255, 0.78); }

  @media (max-width: 820px) {
    .why-grid { grid-template-columns: 1fr; max-width: 440px; margin-inline: auto; }
  }
</style>
