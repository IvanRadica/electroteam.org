---
interface Step {
  title: string;
  text: string;
}
interface Props {
  heading: string;
  intro?: string;
  steps: Step[];
}
const { heading, intro, steps } = Astro.props;
---

<section class="section process bg-offwhite">
  <div class="container">
    <header class="process-head">
      <span class="eyebrow">Kako radimo</span>
      <h2>{heading}</h2>
      {intro && <p class="process-intro">{intro}</p>}
    </header>

    <ol class="timeline">
      {steps.map((s, i) => (
        <li class="timeline-step">
          <div class="step-marker">{i + 1}</div>
          <div class="step-body">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .bg-offwhite { background: var(--et-offwhite); }
  .process-head { text-align: center; max-width: 760px; margin: 0 auto 3rem; }
  .process-intro { color: var(--et-gray); font-size: 1.1rem; margin-top: 0.5rem; }

  .timeline {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 720px;
  }
  .timeline-step {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1.5rem;
    padding-bottom: 2.25rem;
  }
  /* vertikalna crta */
  .timeline-step::before {
    content: '';
    position: absolute;
    left: 27px;
    top: 56px;
    bottom: 0;
    width: 2px;
    background: var(--et-border);
  }
  .timeline-step:last-child { padding-bottom: 0; }
  .timeline-step:last-child::before { display: none; }

  .step-marker {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--et-gold);
    color: var(--et-ink);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }
  .step-body { padding-top: 0.4rem; }
  .step-body h3 { margin-bottom: 0.35rem; }
  .step-body p { color: var(--et-gray); margin: 0; }
</style>
