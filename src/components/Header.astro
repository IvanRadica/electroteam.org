---
import { serviceNav } from '../data/site';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Electro Team — početna">
      <img src="/logo/et-logo-on-gold.png" alt="Electro Team logo" width="180" height="auto" />
    </a>

    <nav class="nav" aria-label="Glavna navigacija">
      <ul>
        <li><a href="/">Početna</a></li>
        <li class="has-dropdown">
          <button class="dropdown-trigger" aria-expanded="false" aria-haspopup="true">
            Usluge
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="submenu">
            {serviceNav.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
          </ul>
        </li>
        <li><a href="/kontakt/">Kontakt</a></li>
      </ul>
    </nav>

    <a class="btn btn--ink header-cta" href="/kontakt/">Besplatna procjena</a>

    <button class="nav-toggle" aria-label="Otvori izbornik" id="navToggle">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--et-gold);
    box-shadow: 0 2px 12px rgba(16, 25, 33, 0.08);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.7rem;
  }
  .brand img {
    height: 70px;
    width: auto;
  }
  .nav > ul {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .submenu {
    list-style: none;
  }
  .nav a,
  .dropdown-trigger {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--et-ink);
    padding-block: 0.25rem;
    border: none;
    border-bottom: 2px solid transparent;
    background: none;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .nav a:hover,
  .dropdown-trigger:hover { border-color: var(--et-ink); }

  /* Dropdown */
  .has-dropdown { position: relative; }
  /* Nevidljivi "most" preko razmaka da hover ne nestane pri prelasku na izbornik */
  .has-dropdown::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 250px;
    height: 0.75rem;
  }
  .dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .dropdown-trigger svg { transition: transform 0.15s ease; }
  .submenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 250px;
    background: var(--et-white);
    border-radius: var(--radius);
    box-shadow: 0 12px 28px rgba(16, 25, 33, 0.18);
    padding: 0.5rem;
    margin-top: 0.5rem;
  }
  .submenu li { display: block; }
  .submenu a {
    display: block;
    padding: 0.6rem 0.85rem;
    border-radius: 8px;
    border: none;
    font-weight: 600;
  }
  .submenu a:hover { background: var(--et-offwhite); }

  .has-dropdown:hover .submenu,
  .has-dropdown:focus-within .submenu { display: block; }
  .has-dropdown:hover .dropdown-trigger svg { transform: rotate(180deg); }

  .header-cta { white-space: nowrap; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }
  .nav-toggle span {
    width: 26px;
    height: 3px;
    background: var(--et-ink);
    border-radius: 2px;
  }

  @media (max-width: 820px) {
    .nav, .header-cta { display: none; }
    .nav-toggle { display: flex; }
    .brand { margin-left: -0.4rem; }
    .brand img { height: 56px; }
    .nav.open {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--et-gold);
      padding: 1rem 2rem 1.5rem;
      box-shadow: 0 8px 16px rgba(16, 25, 33, 0.12);
    }
    .nav.open > ul { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .nav.open .submenu {
      display: block;
      position: static;
      box-shadow: none;
      background: transparent;
      padding: 0.25rem 0 0 1rem;
      margin: 0;
      min-width: 0;
    }
    .nav.open .submenu a { padding: 0.35rem 0; }
    .nav.open .dropdown-trigger svg { display: none; }
    .has-dropdown::after { display: none; }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.querySelector('.nav');
  toggle?.addEventListener('click', () => nav?.classList.toggle('open'));
  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => nav.classList.remove('open'))
  );
</script>
