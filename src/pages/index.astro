---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import WhyUs from '../components/WhyUs.astro';
import ContactArea from '../components/ContactArea.astro';
import Footer from '../components/Footer.astro';

// LocalBusiness schema — PLACEHOLDER podatke (telefon, social) zamijeniti kasnije
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  name: 'Electro Team',
  description:
    'Električar za zamjenu strujnih ormara, elektroinstalacije i hitne intervencije na području Zagreba i Zagrebačke županije.',
  url: 'https://electroteam.org',
  telephone: '+385XXXXXXXXX',
  areaServed: ['Zagreb', 'Zagrebačka županija'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Zagreb',
    addressCountry: 'HR',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '17:00',
  },
};
---

<Base>
  <Header />
  <main>
    <Hero />
    <Services />
    <WhyUs />
    <ContactArea />
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>
